{
  "name": "chessin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "dev": "vite",
    "dev:pages": "bun run build && wrangler pages dev",
    "preview": "bunx vite preview",
    "build": "bun run format && bunx vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "deploy": "bun run build && wrangler pages deploy"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.8",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.19.2",
    "prettier": "^3.10.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@animateicons/vanilla": "^0.2.0",
    "@lucide/svelte": "^1.79.0",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "howler": "^2.2.4",
    "tailwind-merge": "^3.7.1"
  }
